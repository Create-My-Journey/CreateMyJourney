# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=createMyJourney

# Google Maps API Key (for Places API proxy)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostgREST JWT Secret (change in production!)
# PGRST_JWT_SECRET is set in docker-compose.yaml
# Override here if needed: PGRST_JWT_SECRET=your-secret-key-change-this-in-production
